# Docker Environment Variables Example
# Copy this file to .env and fill in your actual values
# DO NOT commit .env with real credentials to version control

CHAINLIT_AUTH_SECRET="chainlit_secret_not_used"

OPENAI_API_KEY=<OPENAI_API_KEY>
PINECONE_API_KEY=<PINECONE_API_KEY>
PINECONE_ENVIRONMENT=gcp-starter

# Keycloak OAuth Configuration for Chainlit
OAUTH_KEYCLOAK_CLIENT_ID=minio
OAUTH_KEYCLOAK_CLIENT_SECRET=<KEYCLOAK_CLIENT_SECRET>
OAUTH_KEYCLOAK_REALM=humaine
OAUTH_KEYCLOAK_BASE_URL=https://keycloak.humaine-horizon.eu
OAUTH_KEYCLOAK_NAME=keycloak

# MinIO Configuration
MINIO_SECURE=true
MINIO_ENDPOINT=s3-minio.humaine-horizon.eu

# Kubeflow Configuration 
KUBEFLOW_HOST=https://kubeflow.humaine-horizon.eu/pipeline
# Leave unset or empty for default shared catalog (unscoped list_pipelines).
# KUBEFLOW_SHARED_NAMESPACE=

# Chainlit chat persistence (SQLite)
# Local dev: leave unset (uses <project>/.chainlit/chat_history.db)
# Docker (with -v humaine-chainlit-data:/data):
# CHAINLIT_DB=sqlite+aiosqlite:////data/chat_history.db

# Langfuse observability (optional; no quotes in Docker --env-file)
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_BASE_URL=https://cloud.langfuse.com

