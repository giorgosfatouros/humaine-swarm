# Copy to `.env` in this directory (`humaine-swarm/`).
# Chainlit does NOT load `common-fe/.env` — use this file or `export` in your shell.

# --- JWKS / Keycloak TLS (header auth from embedded Common FE) ---
# If logs show SSL: CERTIFICATE_VERIFY_FAILED when fetching .../openid-connect/certs:
# Local dev only — disables TLS verification for that JWKS HTTP request only:
# KEYCLOAK_JWKS_SSL_VERIFY=false
# Preferred — PEM bundle for your Keycloak HTTPS issuer:
# KEYCLOAK_CA_BUNDLE=/path/to/ca-bundle.pem

# --- Smart Manufacturing semantic inference (JSI) ---
# SEMANTIC_INFERENCE_BASE_URL=http://atena.ijs.si:5008
# SEMANTIC_INFERENCE_TIMEOUT=30
# SEMANTIC_INFERENCE_API_KEY=   # optional; service has no auth today

# Chainlit chat persistence (SQLite)
# Local dev (default when unset): <project>/.chainlit/chat_history.db
# Docker (use with -v humaine-chainlit-data:/data):
# CHAINLIT_DB=sqlite+aiosqlite:////data/chat_history.db

# --- Langfuse observability (optional, Python SDK v4) ---
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_BASE_URL=https://cloud.langfuse.com
# LANGFUSE_HOST is set from LANGFUSE_BASE_URL at startup if unset.
# LANGFUSE_TRACING_ENVIRONMENT=development
# LANGFUSE_RELEASE=humaine-swarm
